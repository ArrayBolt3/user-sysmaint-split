## This is separate from sysmaint-session and sysmaint-session-wayland so that
## labwc can start it using the --session option.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

# shellcheck source=./sysmaint-session-shared
source /usr/libexec/user-sysmaint-split/sysmaint-session-shared

## Exported by the session scripts that invoke this one, so it is absent if
## this runs on its own. Unset previously took the non-wayland branch, which
## ':-' reproduces instead of aborting under nounset.
if [ "${XDG_SESSION_TYPE:-}" = 'wayland' ]; then
   system_tray_list=(
      '/usr/bin/waybar'
   )
   system_tray_arg_list=(
      ''
   )
else
   system_tray_list=(
      '/usr/bin/trayer'
   )
   system_tray_arg_list=(
      '--edge top --align right --SetPartialStrut true'
   )
fi

selected_system_tray=''
selected_system_tray_args=''

for idx in "${!system_tray_list[@]}"; do
   if [ -e "${system_tray_list[idx]}" ]; then
      selected_system_tray="${system_tray_list[idx]}"
      selected_system_tray_args="${system_tray_arg_list[idx]}"
      break
   fi
done

if [ -n "${selected_system_tray}" ]; then
   # shellcheck disable=SC2086
   "${selected_system_tray}" ${selected_system_tray_args} &
fi

## Best-effort, deliberately: this is labwc's --startup script, so a
## non-zero exit can take the session down with it. Starting the user
## background services was already tolerant of individual failures
## before strict mode -- a notification service already being
## registered, for instance -- and must stay so.
start_user_background_services || true
