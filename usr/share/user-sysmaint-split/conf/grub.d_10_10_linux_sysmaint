#!/bin/bash

## Every assignment here is exported by the 'set -o allexport' below and
## read by grub-mkconfig and by the child /etc/grub.d/10_00_linux_dist,
## so shellcheck's "appears unused" does not apply.
# shellcheck disable=SC2034

## Copyright (C) 2024 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

#set -x

true "user-sysmaint-split $0: START"

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
set -o allexport


make_boot_entry='true'

: "${persistence_type:="PERSISTENT"}"
: "${session_detail:="system maintenance tasks"}"

grub_distributor_appendix="${persistence_type} Mode | SYSMAINT Session | ${session_detail}"
GRUB_DISTRIBUTOR="${grub_distributor_appendix}"

GRUB_DISABLE_RECOVERY="true"
## grub-mkconfig normally sources /etc/default/grub, which sets this --
## but it is not guaranteed, and appending to it bare aborts under nounset
## and takes the whole grub config generation with it.
GRUB_CMDLINE_LINUX="${GRUB_CMDLINE_LINUX:-} boot-role=sysmaint systemd.unit=sysmaint-boot.target"

if test -x /etc/grub.d/10_00_linux_dist ; then
	/etc/grub.d/10_00_linux_dist
fi

true "user-sysmaint-split $0: OK: END"
